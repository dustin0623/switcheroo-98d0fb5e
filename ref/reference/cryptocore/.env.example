# ============================================================
# CryptoCore — Environment Variables
# Copy this file to .env and fill in the values for the
# environment you are running (local dev, Coolify, etc.).
# ============================================================


# ------------------------------------------------------------
# FRONTEND (Vite / TanStack Start)
# ------------------------------------------------------------
# These variables must be available when Vite builds the app.
# In dev they are read from .env automatically.
# In production they must be set before running `vite build`.

# Full URL of the CryptoCore Game API the browser will call.
# Example production: https://api.cryptocore.yourdomain.com
VITE_SERVER_API_URL=http://localhost:3000


# ------------------------------------------------------------
# BACKEND API (server/game-api)
# Run with: pnpm server:api
# ------------------------------------------------------------

# Port the Express API listens on (default: 3000).
PORT=3000

# MongoDB connection string.
# Example Atlas: mongodb+srv://user:pass@cluster.mongodb.net/cryptocore?retryWrites=true&w=majority
# Example local:  mongodb://localhost:27017/cryptocore
MONGODB_URI=

# MongoDB database name (default: cryptocore).
MONGODB_DB=cryptocore

# Secret used to sign and verify JWT session tokens.
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Comma-separated list of origins allowed to call the API via CORS.
# Include your frontend URL(s) here.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173


# ------------------------------------------------------------
# BLOCKCHAIN (Solana)
# Used by both the API and the withdrawal/deposit worker.
# ------------------------------------------------------------

# SPL token mint / contract address for the game token (HASH).
CONTRACT_ADDRESS=

# Treasury wallet that receives deposits and pays withdrawals.
TREASURY_ADDRESS=

# Treasury private key (server-only, never expose to the client).
# Accepts a base58 string (Phantom export format).
TREASURY_KEY=

# Solana JSON-RPC endpoint used by the server and exposed to the browser.
# Use devnet for testing: https://api.devnet.solana.com
# Use mainnet for production: https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# Helius API key (server-only). Used to build a reliable RPC endpoint for
# on-chain verification and treasury payouts. Optional but recommended.
# Get one at https://helius.dev
HELIUS_API_KEY=


# ------------------------------------------------------------
# OPTIONAL / OPERATIONAL
# ------------------------------------------------------------

# Withdrawal/deposit worker poll interval in milliseconds (default: 5000).
WORKER_POLL_MS=5000

# Max retries before a pending withdrawal is dead-lettered (default: 8).
WORKER_MAX_RETRIES=8

# Node environment. Set to "production" to hide detailed error messages.
NODE_ENV=development
