{
  "endpoint": "GET /api/mock/stats",
  "description": "Aggregate in-game economy stats. Mirrors the layout of https://www.terracoregame.com/stats but computed entirely from local mock data (no blockchain reads).",
  "response": "StatsResponse",
  "types": {
    "StatsResponse": {
      "totals": {
        "players": "integer",
        "liquidScrap": "number",
        "liquidFlux": "number",
        "stakedScrap": "number",
        "burnedScrap": "number",
        "burnedFlux": "number"
      },
      "series": {
        "players": "TimeSeriesPoint[] — daily new + cumulative players",
        "salvagedItems": "SalvagePoint[] — daily item counts and FLUX flows",
        "dailyActivity": "ActivityPoint[] — daily battles and quests",
        "bossBattles": "BossPoint[] — daily boss wins and losses",
        "scrapStaked": "TimeSeriesPoint[]",
        "scrapBurned": "TimeSeriesPoint[]",
        "marketVolume": "TimeSeriesPoint[] — in HIVE",
        "marketTransactions": "TimeSeriesPoint[]"
      }
    },
    "TimeSeriesPoint": { "date": "string YYYY-MM-DD", "value": "number", "cumulative": "number?" },
    "SalvagePoint": { "date": "string", "items": "integer", "generatedFlux": "number", "burntFlux": "number", "spentFlux": "number" },
    "ActivityPoint": { "date": "string", "battles": "integer", "quests": "integer" },
    "BossPoint": { "date": "string", "wins": "integer", "losses": "integer" }
  }
}
