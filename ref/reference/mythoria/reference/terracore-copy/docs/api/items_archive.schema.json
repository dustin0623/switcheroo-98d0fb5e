{
  "endpoint": "GET /api/mock/items_archive",
  "description": "In-game Items Archive — every unique item template that can ever exist in Terracore. Real Terracore serves the equivalent as the full NFT catalog at https://api.terracoregame.com/items. Our copy is served from the local mock dataset so we don't depend on the blockchain.",
  "response": "ItemTemplate[]",
  "query": {
    "type": "string? — filter by 'ship'|'weapon'|'armor'|'avatar'|'special'",
    "rarity": "string? — filter by 'common'|'uncommon'|'rare'|'epic'|'legendary'",
    "edition": "string? — filter by edition (currently only 'beta')",
    "sort": "string? — one of 'item_asc'|'item_desc'|'damage'|'defense'|'engineering'|'crit'|'dodge'|'luck'",
    "limit": "integer? — default 60, max 500",
    "offset": "integer? — default 0"
  },
  "types": {
    "ItemTemplate": {
      "id": "integer — template id",
      "item_number": "integer — first mint / display number",
      "name": "string",
      "type": "'avatar'|'weapon'|'armor'|'ship'|'special'",
      "rarity": "'common'|'uncommon'|'rare'|'epic'|'legendary'",
      "edition": "string",
      "max_supply": "integer",
      "supply_minted": "integer",
      "image": "string — image URL or empty",
      "description": "string",
      "attributes": "Attributes — same shape as items.schema.json"
    }
  }
}
